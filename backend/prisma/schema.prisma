generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Ocorrencia {
  id           Int       @id @default(autoincrement())
  titulo       String
  descricao    String
  categoria    String
  cep          String?
  quadra       String    // Texto livre preenchido via ViaCEP ou digitado (ex: QR 406, QN 314, QS 502)
  localizacao  String
  latitude     Float     @default(-15.8755)
  longitude    Float     @default(-48.0860)
  imagemBase64 String?
  autor        String    @default("Denúncia Anônima")
  anonimo      Boolean   @default(true)
  status       String    @default("ABERTO") // "ABERTO" | "EM_ANDAMENTO" | "RESOLVIDO"
  apoios       Int       @default(1)
  resolvidoEm  DateTime?
  criadoEm     DateTime  @default(now())
}

model Evento {
  id           Int      @id @default(autoincrement())
  titulo       String
  descricao    String
  dataEvento   String
  cep          String?
  quadra       String
  local        String
  latitude     Float    @default(-15.8755)
  longitude    Float    @default(-48.0860)
  imagemBase64 String?
  organizador  String
  criadoEm     DateTime @default(now())
}

